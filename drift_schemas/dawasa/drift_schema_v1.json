  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'LKR', \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"opening_date\" TEXT NULL, \"color_value\" INTEGER NULL, \"icon_key\" TEXT NULL, \"include_in_total\" INTEGER NOT NULL DEFAULT 1 CHECK (\"include_in_total\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transaction_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transaction_categories\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"system_key\" TEXT NULL, \"name\" TEXT NULL, \"icon_key\" TEXT NOT NULL DEFAULT 'category', \"color_value\" INTEGER NOT NULL DEFAULT 4284773515, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), UNIQUE (\"kind\", \"system_key\"), CHECK (system_key IS NOT NULL OR name IS NOT NULL));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rules\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"rule\" TEXT NOT NULL, \"start_date\" TEXT NOT NULL, \"next_date\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'LKR', \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"to_account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"category_id\" TEXT NULL REFERENCES transaction_categories (id) ON DELETE SET NULL, \"description\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NULL, \"time_of_day_minutes\" INTEGER NOT NULL DEFAULT 720, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), CHECK (type IN ('expense', 'income', 'transfer')));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'LKR', \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"to_account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"category_id\" TEXT NULL REFERENCES transaction_categories (id) ON DELETE SET NULL, \"occurred_at\" TEXT NOT NULL, \"local_date\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NULL, \"attachment_id\" TEXT NULL REFERENCES attachments (id) ON DELETE SET NULL, \"recurring_rule_id\" TEXT NULL REFERENCES recurring_rules (id) ON DELETE SET NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"source_ref_id\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), CHECK ((type = 'transfer') = (to_account_id IS NOT NULL)), CHECK (to_account_id IS NULL OR to_account_id <> account_id));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "schema_migrations",
