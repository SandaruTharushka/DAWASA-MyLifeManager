        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schema_migrations\" (\"version\" INTEGER NOT NULL, \"applied_at\" TEXT NOT NULL, \"description\" TEXT NOT NULL, PRIMARY KEY (\"version\"));"
        }
      ]
